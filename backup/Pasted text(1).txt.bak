<input class="w-full px-4 py-3 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-secondary transition-all" id="location-text" placeholder="e.g. Student Union Ground Floor, near Starbucks" required="" type="text" value="Student Union Ground Floor, near Starbucks seating"/>
<span class="absolute right-3.5 top-3.5 text-on-surface-variant material-symbols-outlined text-[20px]">location_on</span>
</div>
</div>
