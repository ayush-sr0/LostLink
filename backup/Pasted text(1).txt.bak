"space-lg":"1.5rem","space-xs":"0.25rem","space-xl":"2.5rem","gutter-mobile":"1rem"},fontFamily:{"headline-lg-mobile":["Plus Jakarta Sans"],"headline-sm":["Plus Jakarta Sans"],"label-lg":["Inter"],"label-caps":["Inter"],"headline-md":["Plus Jakarta Sans"],"label-md":["Inter"],"body-lg":["Inter"],"body-sm":["Inter"],display:["Plus Jakarta Sans"],"headline-lg":["Plus Jakarta Sans"],"body-md":["Inter"]},fontSize:{"headline-lg-mobile":["1.75rem",{lineHeight:"2.25rem",letterSpacing:"-0.02em",fontWeight:"700"}],"headline-sm":["1.25rem",{lineHeight:"1.75rem",letterSpacing:"-0.01em",fontWeight:"600"}],"label-lg":["0.875rem",{lineHeight:"1.25rem",letterSpacing:"0.01em",fontWeight:"600"}],"label-caps":["0.6875rem",{lineHeight:"0.875rem",letterSpacing:"0.06em",fontWeight:"700"}],"headline-md":["1.5rem",{lineHeight:"2rem",letterSpacing:"-0.015em",fontWeight:"600"}],"label-md":["0.75rem",{lineHeight:"1rem",letterSpacing:"0.02em",fontWeight:"600"}],"body-lg":["1.125rem",{lineHeight:"1.75rem",fontWeight:"400"}],"body-sm":["0.875rem",{lineHeight:"1.25rem",fontWeight:"400"}],display:["3.5rem",{lineHeight:"4rem",letterSpacing:"-0.03em",fontWeight:"800"}],"headline-lg":["2.25rem",{lineHeight:"2.75rem",letterSpacing:"-0.02em",fontWeight:"700"}],"body-md":["1rem",{lineHeight:"1.5rem",fontWeight:"400"}]}}}}</script></head><body class="bg-surface font-body-md text-body-md text-on-surface antialiased"><main class="w-full min-h-screen bg-surface flex flex-col justify-center items-center p-4 sm:p-6 lg:p-8"><div class="flex flex-col w-full">
<div class="w-full max-w-7xl mx-auto rounded-xl shadow-xl overflow-hidden my-auto grid grid-cols-1 lg:grid-cols-12 bg-surface-container-lowest">
<!-- Left Hero/Trust Column -->
<div class="lg:col-span-6 bg-primary-container text-on-primary relative flex flex-col justify-between p-8 sm:p-12 lg:p-16 overflow-hidden">
<!-- Ambient Lighting and Tech Texture -->
<div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-secondary opacity-30 blur-3xl pointer-events-none"></div>
<div class="absolute bottom-0 right-0 w-80 h-80 rounded-full bg-secondary-container opacity-20 blur-3xl pointer-events-none"></div>
<!-- Subtle Decorative Grid Mesh -->
<div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, #ffffff 1px, transparent 0); background-size: 24px 24px;"></div>
<!-- Top Branding -->
<div class="relative z-10 flex items-center gap-3">
<div class="w-10 h-10 rounded-xl bg-secondary flex items-center justify-center text-on-secondary shadow-md">
<span class="material-symbols-outlined text-headline-sm" style="font-variation-settings: 'FILL' 1;">sync_saved_locally</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-surface-bright tracking-tight leading-none">Lost Link</span>
<span class="font-label-caps text-label-caps text-on-primary-container tracking-wider uppercase">Campus &amp; Transit Recovery</span>
</div>
</div>
<!-- Middle Story & Value Props -->
<div class="relative z-10 my-10 lg:my-14 space-y-8">
<div class="space-y-3">
<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-variant/20 text-secondary-fixed">
<span class="w-2 h-2 rounded-full bg-secondary-container animate-ping"></span>
<span class="font-label-caps text-label-caps tracking-wider uppercase font-semibold">140+ Hubs Synchronized</span>
</div>
<h1 class="font-headline-lg text-headline-lg text-surface-bright leading-tight">
            Reuniting Communities, One Valued Item at a Time.
          </h1>
<p class="font-body-md text-body-md text-on-primary-container leading-relaxed">
            A trusted cross-hub ecosystem engineered to resolve item loss seamlessly between students, commuters, and facilities security.
          </p>
</div>
<div class="space-y-4">
<div class="flex items-start gap-3">
<div class="p-1 rounded-lg bg-secondary/20 text-secondary-container mt-0.5">
<span class="material-symbols-outlined text-body-md font-bold">check_circle</span>
</div>
<p class="font-body-sm text-body-sm text-inverse-on-surface">
              Instant automated cross-matching across 140+ campus and transit hubs.
            </p>
</div>
<div class="flex items-start gap-3">
<div class="p-1 rounded-lg bg-secondary/20 text-secondary-container mt-0.5">
<span class="material-symbols-outlined text-body-md font-bold">verified_user</span>
</div>
<p class="font-body-sm text-body-sm text-inverse-on-surface">
              Zero-knowledge private ownership verification to eliminate false claims.
            </p>
</div>
<div class="flex items-start gap-3">
<div class="p-1 rounded-lg bg-secondary/20 text-secondary-container mt-0.5">
<span class="material-symbols-outlined text-body-md font-bold">lock</span>
</div>
<p class="font-body-sm text-body-sm text-inverse-on-surface">
              End-to-end encrypted messaging between finders, owners, and security desks.
            </p>
</div>
</div>
<!-- Social Proof Quote Card -->
<div class="p-5 rounded-xl bg-surface/10 backdrop-blur-md shadow-md text-on-primary space-y-3">
<div class="flex items-center gap-1 text-secondary-container">
<span class="material-symbols-outlined text-label-lg" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-label-lg" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-label-lg" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-label-lg" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-label-lg" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
<p class="font-body-sm text-body-sm text-surface-bright italic leading-relaxed">
            “Lost my MacBook sleeve on the campus shuttle and thought it was gone forever. Lost Link notified me 45 minutes later that dispatch had logged it!”
          </p>
<div class="flex items-center gap-3 pt-1">
<img class="w-10 h-10 rounded-full object-cover shadow" data-alt="Editorial headshot of Alex Chen, an Asian university student with glasses smiling comfortably outdoors against a blurred collegiate library background in natural daylight" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCAHnkWS0d45ZooWcII-vIhtQqGd0rcamiH2kea1QNzBR3GOmKU9qn1P9R2VNQwoocn8T9bJu0FmwkHiBufAiCNwu4lu_LA3sRCmW7lZE4sGMUisdPPMd87HAljsMROqayFmURHz3OXWEeWlMDQRxBjnYQjT8SzmSbPK6sJ_kOdl9iUWqqE50j2_PhmJgZo9zxqrjPSoDXd3E8CXRLqZV5Y3zPSf3kW8TT_I0nBaafm"/>
<div>
<p class="font-label-lg text-label-lg text-surface-bright">Alex Chen</p>
<p class="font-label-md text-label-md text-on-primary-container">Stanford University</p>
</div>
</div>
</div>
</div>
<!-- Trust Badges Footer -->
<div class="relative z-10 pt-4 space-y-3">
<p class="font-label-caps text-label-caps text-on-primary-container uppercase tracking-widest">
          Trusted Institutional Ecosystem
        </p>
<div class="flex flex-wrap items-center gap-6 opacity-75">
<div class="flex items-center gap-1.5 font-label-md text-label-md text-surface-bright">
<span class="material-symbols-outlined text-body-md text-secondary-container">school</span>
<span>PAC-12 Unified</span>
</div>
<div class="flex items-center gap-1.5 font-label-md text-label-md text-surface-bright">
<span class="material-symbols-outlined text-body-md text-secondary-container">directions_subway</span>
<span>Metro Transit Authority</span>
</div>
<div class="flex items-center gap-1.5 font-label-md text-label-md text-surface-bright">
<span class="material-symbols-outlined text-body-md text-secondary-container">security</span>
<span>Campus Safety ISO</span>
</div>
</div>
</div>
</div>
<!-- Right Interaction & Form Column -->
<div class="lg:col-span-6 p-8 sm:p-12 lg:p-16 flex flex-col justify-center bg-surface-container-lowest">
<div class="w-full max-w-md mx-auto space-y-6">
<!-- Toggle Tabs: Log In / Create Account -->
<div class="p-1 rounded-xl bg-surface-container flex items-center">
<button class="flex-1 py-2 rounded-lg font-label-lg text-label-lg transition-all shadow-sm bg-surface-container-lowest text-on-surface font-semibold text-center" id="tab-login" onclick="switchAuthMode('login')" type="button">
            Log In
          </button>
<button class="flex-1 py-2 rounded-lg font-label-lg text-label-lg transition-all text-on-surface-variant hover:text-on-surface font-medium text-center" id="tab-signup" onclick="switchAuthMode('signup')" type="button">
            Create Account
          </button>
</div>
<!-- Form Heading -->
<div class="space-y-1">
<h2 class="font-headline-md text-headline-md text-on-surface" id="auth-title">
            Welcome to Lost Link
          </h2>
<p class="font-body-sm text-body-sm text-on-surface-variant" id="auth-subtitle">
            Enter your credentials or university SSO to access your recovery dashboard.
          </p>
</div>
<!-- SSO Options -->
<div class="space-y-3">
<!-- Institutional SSO Button -->
<button class="w-full h-11 px-4 rounded-xl bg-secondary text-on-secondary font-label-lg text-label-lg flex items-center justify-center gap-3 shadow hover:bg-secondary/90 transition-all focus:outline-none" type="button">
<span class="material-symbols-outlined text-headline-sm">account_balance</span>
<span id="sso-label">Continue with University SSO</span>
</button>
<!-- Google Auth Button -->
<button class="w-full h-11 px-4 rounded-xl bg-surface-container-low text-on-surface font-label-lg text-label-lg flex items-center justify-center gap-3 hover:bg-surface-container transition-all focus:outline-none" type="button">
<svg aria-hidden="true" class="w-4 h-4" viewbox="0 0 24 24">
<path d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.15z" fill="#4285F4"></path>
<path d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.26v3.15C3.25 21.37 7.33 24 12 24z" fill="#34A853"></path>
<path d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.26C.46 8.16 0 9.97 0 12s.46 3.84 1.26 5.42l4.02-3.15z" fill="#FBBC05"></path>
<path d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.25 2.63 1.26 6.58l4.02 3.15c.95-2.83 3.6-4.98 6.72-4.98z" fill="#EA4335"></path>
</svg>
<span>Continue with Google</span>
</button>
</div>
<!-- Divider -->
<div class="relative flex items-center justify-center my-4">
<div class="w-full h-px bg-surface-container-high"></div>
<span class="absolute px-3 bg-surface-container-lowest font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">
            or continue with email
          </span>
</div>
<!-- Form Elements -->
<form class="space-y-4" onsubmit="handleAuthSubmit(event)">
<!-- Additional sign-up field dynamically shown -->
<div class="hidden space-y-1.5" id="full-name-field">
<label class="block font-label-md text-label-md text-on-surface" for="fullName">Full Name</label>
<div class="relative">
<span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-outline">
<span class="material-symbols-outlined text-body-md">person</span>
</span>
<input class="w-full h-11 pl-10 pr-3 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-secondary transition-all" id="fullName" placeholder="Morgan Lin" type="text"/>
</div>
</div>
<!-- Email Field -->
<div class="space-y-1.5">
<label class="block font-label-md text-label-md text-on-surface" for="email">
              Institutional or Personal Email
            </label>
<div class="relative">
<span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-outline">
<span class="material-symbols-outlined text-body-md">mail</span>
</span>
<input class="w-full h-11 pl-10 pr-3 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-secondary transition-all" id="email" placeholder="e.g. mlin@university.edu" required="" type="email"/>
</div>
</div>
<!-- Password Field -->
<div class="space-y-1.5">
<div class="flex items-center justify-between">
<label class="block font-label-md text-label-md text-on-surface" for="password">Password</label>
<a class="font-label-md text-label-md text-secondary hover:underline" href="#" id="forgot-password-link">
                Forgot password?
              </a>
</div>
<div class="relative">
<span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-outline">
<span class="material-symbols-outlined text-body-md">key</span>
</span>
<input class="w-full h-11 pl-10 pr-11 rounded-xl bg-surface-container-low text-on-surface font-body-sm text-body-sm placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-secondary transition-all" id="password" placeholder="••••••••••••" required="" type="password"/>
<button aria-label="Toggle password visibility" class="absolute inset-y-0 right-0 pr-3 flex items-center text-outline hover:text-on-surface focus:outline-none" onclick="togglePasswordVisibility()" type="button">
<span class="material-symbols-outlined text-body-md" id="eye-icon">visibility</span>
</button>
</div>
</div>
<!-- Checkbox / Remember Me -->
<div class="flex items-center justify-between pt-1">
<label class="flex items-center gap-2 cursor-pointer select-none">
<input checked="" class="w-4 h-4 rounded text-secondary focus:ring-0 cursor-pointer" id="remember" type="checkbox"/>
<span class="font-body-sm text-body-sm text-on-surface-variant" id="remember-label">Remember this device</span>
</label>
</div>
<!-- Submit Button -->
<button class="w-full h-11 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-semibold hover:bg-primary/90 transition-all flex items-center justify-center gap-2 shadow-md" id="auth-submit-btn" type="submit">
<span>Log In to Lost Link</span>
<span class="material-symbols-outlined text-body-md">arrow_forward</span>
</button>
</form>
<!-- Switch prompt footer -->
<div class="text-center pt-2">
<p class="font-body-sm text-body-sm text-on-surface-variant">
<span id="switch-prompt-text">Don’t have an account?</span>
<button class="font-label-lg text-label-lg text-secondary font-semibold hover:underline ml-1 focus:outline-none" id="switch-prompt-btn" onclick="toggleModeFromFooter()" type="button">
              Sign up for free
            </button>
</p>
</div>
<!-- Security & Protocol Badge -->
<div class="pt-4 flex items-center justify-center gap-2 text-on-surface-variant font-label-caps text-label-caps text-center">
<span class="material-symbols-outlined text-label-lg text-secondary">verified</span>
<span>Protected by 256-bit SSL encryption &amp; Campus Security Protocols.</span>
</div>
</div>
</div>
</div>
<script>
    let currentAuthMode = 'login';

    function switchAuthMode(mode) {
      currentAuthMode = mode;
      const tabLogin = document.getElementById('tab-login');
      const tabSignup = document.getElementById('tab-signup');
      const authTitle = document.getElementById('auth-title');
      const authSubtitle = document.getElementById('auth-subtitle');
      const fullNameField = document.getElementById('full-name-field');
      const authSubmitBtn = document.getElementById('auth-submit-btn');
      const forgotPasswordLink = document.getElementById('forgot-password-link');
      const switchPromptText = document.getElementById('switch-prompt-text');
      const switchPromptBtn = document.getElementById('switch-prompt-btn');
      const rememberLabel = document.getElementById('remember-label');
      const ssoLabel = document.getElementById('sso-label');

      if (mode === 'signup') {
        tabSignup.className = "flex-1 py-2 rounded-lg font-label-lg text-label-lg transition-all shadow-sm bg-surface-container-lowest text-on-surface font-semibold text-center";
        tabLogin.className = "flex-1 py-2 rounded-lg font-label-lg text-label-lg transition-all text-on-surface-variant hover:text-on-surface font-medium text-center";

        authTitle.innerText = "Join the Recovery Network";
        authSubtitle.innerText = "Set up your student or commuter account in less than a minute.";
        fullNameField.classList.remove('hidden');
        forgotPasswordLink.classList.add('hidden');
        rememberLabel.innerText = "Agree to University Safety Code & Privacy Terms";
        ssoLabel.innerText = "Sign up with University SSO";
        authSubmitBtn.innerHTML = '<span>Create Free Account</span><span class="material-symbols-outlined text-body-md">arrow_forward</span>';
        switchPromptText.innerText = "Already registered on Lost Link?";
        switchPromptBtn.innerText = "Log in";
      } else {
        tabLogin.className = "flex-1 py-2 rounded-lg font-label-lg text-label-lg transition-all shadow-sm bg-surface-container-lowest text-on-surface font-semibold text-center";
        tabSignup.className = "flex-1 py-2 rounded-lg font-label-lg text-label-lg transition-all text-on-surface-variant hover:text-on-surface font-medium text-center";

        authTitle.innerText = "Welcome to Lost Link";
        authSubtitle.innerText = "Enter your credentials or university SSO to access your recovery dashboard.";
        fullNameField.classList.add('hidden');
        forgotPasswordLink.classList.remove('hidden');
        rememberLabel.innerText = "Remember this device";
        ssoLabel.innerText = "Continue with University SSO";
        authSubmitBtn.innerHTML = '<span>Log In to Lost Link</span><span class="material-symbols-outlined text-body-md">arrow_forward</span>';
        switchPromptText.innerText = "Don’t have an account?";
        switchPromptBtn.innerText = "Sign up for free";
      }
    }

    function toggleModeFromFooter() {
      switchAuthMode(currentAuthMode === 'login' ? 'signup' : 'login');
    }

    function togglePasswordVisibility() {
      const passwordInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eye-icon');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.innerText = 'visibility_off';
      } else {
        passwordInput.type = 'password';
        eyeIcon.innerText = 'visibility';
      }
    }

    function handleAuthSubmit(event) {
      event.preventDefault();
      const submitBtn = document.getElementById('auth-submit-btn');
      const initialHtml = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="material-symbols-outlined text-body-md animate-spin">progress_activity</span><span>Authenticating...</span>';

      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = initialHtml;
      }, 1200);
    }
  </script>
</div></main></body></html>

