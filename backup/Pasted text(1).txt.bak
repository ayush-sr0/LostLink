<!-- Detailed Description & Context Section -->
<div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 shadow-sm flex flex-col gap-6">
<div>
<div class="flex items-center gap-2 mb-2">
<span class="material-symbols-outlined text-[20px] text-secondary">description</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">Item Description &amp; Context</h2>
</div>
<p class="font-body-md text-body-md text-on-surface leading-relaxed">
              Found on the 3rd Floor quiet study tables in the main campus library adjacent to study cubicle 34. The device is an authentic Apple AirPods Pro (2nd Generation) enclosed in a protective forest green matte silicone case. It includes a dark metallic carabiner clip bearing a distinct anime miniature acrylic keycharm. A faint custom laser engraving is present along the rear hinge casing.
            </p>
</div>
<!-- Location Context Map Preview -->
<div class="rounded-xl overflow-hidden bg-surface-container relative">
<div class="p-3 bg-surface-container-high flex items-center justify-between">
<span class="font-label-md text-label-md text-on-surface font-semibold flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-secondary">pin_drop</span>
                Found Ground: Main Library, East Wing
              </span>
