<!-- Client-side interaction script -->
<script>
    function selectCondition(el) {
      const chips = document.querySelectorAll('.condition-chip');
      chips.forEach(c => {
        c.className = 'condition-chip py-2.5 px-3 rounded-lg text-center font-label-md text-label-md bg-surface-container-low text-on-surface-variant hover:bg-surface-container transition-all';
      });
      el.className = 'condition-chip py-2.5 px-3 rounded-lg text-center font-label-md text-label-md bg-secondary-fixed text-on-secondary-fixed font-bold shadow-sm transition-all';
    }

    function updateCustodyView(mode) {
      const labels = document.querySelectorAll('#custody-options label');
      labels.forEach(l => {
        l.className = 'relative flex items-start gap-4 p-4 rounded-xl cursor-pointer bg-surface-container-low hover:bg-surface-container transition-all';
      });
      event.currentTarget.closest('label').className = 'relative flex items-start gap-4 p-4 rounded-xl cursor-pointer bg-surface-container-high transition-all';
    }

    function triggerSubmitFeedback() {
      const btn = document.querySelector('button[type="submit"]');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">refresh</span> Processing Verification...';
      btn.disabled = true;
      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-[20px]">check_circle</span> Listing Active! Redirecting...';
        btn.classList.remove('bg-primary');
        btn.classList.add('bg-tertiary-container', 'text-on-tertiary-container');
        setTimeout(() => {
          window.location.hash = '#dashboard';
        }, 1200);
      }, 900);
    }
  </script>
</div></main><footer class="w-full bg-surface-container-lowest border-t border-outline-variant/30"><div class="bg-surface-container-low/60 border-b border-outline-variant/20 py-3 px-4 sm:px-6 lg:px-8"><div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4 font-label-md text-label-md"><div class="flex items-center gap-2.5"><span class="flex h-2.5 w-2.5 rounded-full bg-tertiary-fixed-dim animate-pulse"></span><span class="font-label-lg text-label-lg text-on-surface">System Operational:</span><span class="text-on-surface-variant">All campus &amp; community recovery feeds active</span></div><div class="flex items-center gap-6 text-on-surface-variant"><span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[16px] text-secondary">lock</span> 256-bit Encrypted Claim Registry</span><span class="hidden md:flex items-center gap-1.5"><span class="material-symbols-outlined text-[16px] text-secondary">shield</span> FERPA &amp; Campus Privacy Compliant</span></div></div></div><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16"><div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-12"><div class="col-span-2"><a class="flex items-center gap-2.5 mb-4" data-path="home" href="#"><img alt="Lost Link Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/ALJJyrAWkuYliyQSJANRbojEO-eUUWgyAcLcHTK2--plMIchupuR3pZIDpC6_3MBxU-wFd3VQaPAH8C70WC5-9qiyDPdwjLym2mjQ6JuheG-qSpwg0S3Ww49hsjkYgniXstMt9UQklivfrH8eaprzVxd5Qd3uEg1O3rlV-HADiDWggYqmHh0HCQuYOwJKZqWjadissjaDuFU-k-tGYSVJwLF7rfkVkzMrwCRzW9uhR6PeoavQg"/><span class="font-headline-sm text-headline-sm text-primary tracking-tight">Lost<span class="text-secondary">Link</span></span></a><p class="font-body-sm text-body-sm text-on-surface-variant max-w-sm mb-6">The trusted community-powered network engineered to resolve the stress of lost property. Connecting finders, owners, and security operations with verifiable high-integrity claims.</p><div class="flex items-center gap-3 text-on-surface-variant"><a aria-label="Global Network" class="p-2 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors" href="#"><span class="material-symbols-outlined text-[20px]">public</span></a><a aria-label="Security Shield" class="p-2 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors" href="#"><span class="material-symbols-outlined text-[20px]">verified</span></a><a aria-label="Help Center" class="p-2 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors" href="#"><span class="material-symbols-outlined text-[20px]">contact_support</span></a><a aria-label="RSS Updates" class="p-2 rounded-lg hover:bg-surface-container hover:text-on-surface transition-colors" href="#"><span class="material-symbols-outlined text-[20px]">rss_feed</span></a></div></div><div><p class="font-label-caps text-label-caps text-on-surface uppercase tracking-wider mb-4">Product</p><ul class="space-y-3 font-body-sm text-body-sm"><li data-active-classes="bg-surface-container text-on-surface font-bold"><a class="text-on-surface-variant hover:text-on-surface transition-colors" data-path="search" href="#">Search Registry</a></li><li data-active-classes="bg-surface-container text-on-surface font-bold"><a class="text-on-surface-variant hover:text-on-surface transition-colors" data-path="report-lost" href="#">Report Lost Property</a></li><li data-active-classes="bg-surface-container text-on-surface font-bold"><a class="text-on-surface-variant hover:text-on-surface transition-colors" data-path="report-found" href="#">Report Found Item</a></li><li data-active-classes="bg-surface-container text-on-surface font-bold"><a class="text-on-surface-variant hover:text-on-surface transition-colors" data-path="dashboard" href="#">Claims Hub</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">AI Visual Matcher</a></li></ul></div><div><p class="font-label-caps text-label-caps text-on-surface uppercase tracking-wider mb-4">Campus &amp; Security</p><ul class="space-y-3 font-body-sm text-body-sm"><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Security Partner Portal</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Custody Transfer Protocol</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Campus Security Dispatch</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Verification Badges</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Community Guidelines</a></li></ul></div><div><p class="font-label-caps text-label-caps text-on-surface uppercase tracking-wider mb-4">Legal &amp; Trust</p><ul class="space-y-3 font-body-sm text-body-sm"><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Privacy Policy</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Terms of Custody</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Trust &amp; Safety Standards</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Law Enforcement Request</a></li><li><a class="text-on-surface-variant hover:text-on-surface transition-colors" href="#">Security Vulnerability</a></li></ul></div></div><div class="mt-12 pt-8 border-t border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-4 font-body-sm text-body-sm text-on-surface-variant"><p>© 2025 Lost Link Technologies Inc. All rights reserved.</p><div class="flex items-center gap-6 font-label-md text-label-md"><a class="text-on-surface-variant hover:text-on-surface transition-colors" data-path="login" href="#">Auth &amp; Login</a><a class="text-on-surface-variant hover:text-on-surface transitio