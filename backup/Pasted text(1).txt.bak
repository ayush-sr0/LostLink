"space-lg":"1.5rem","space-xs":"0.25rem","space-xl":"2.5rem","gutter-mobile":"1rem"},fontFamily:{"headline-lg-mobile":["Plus Jakarta Sans"],"headline-sm":["Plus Jakarta Sans"],"label-lg":["Inter"],"label-caps":["Inter"],"headline-md":["Plus Jakarta Sans"],"label-md":["Inter"],"body-lg":["Inter"],"body-sm":["Inter"],display:["Plus Jakarta Sans"],"headline-lg":["Plus Jakarta Sans"],"body-md":["Inter"]},fontSize:{"headline-lg-mobile":["1.75rem",{lineHeight:"2.25rem",letterSpacing:"-0.02em",fontWeight:"700"}],"headline-sm":["1.25rem",{lineHeight:"1.75rem",letterSpacing:"-0.01em",fontWeight:"600"}],"label-lg":["0.875rem",{lineHeight:"1.25rem",letterSpacing:"0.01em",fontWeight:"600"}],"label-caps":["0.6875rem",{lineHeight:"0.875rem",letterSpacing:"0.06em",fontWeight:"700"}],"headline-md":["1.5rem",{lineHeight:"2rem",letterSpacing:"-0.015em",fontWeight:"600"}],"label-md":["0.75rem",{lineHeight:"1rem",letterSpacing:"0.02em",fontWeight:"600"}],"body-lg":["1.125rem",{lineHeight:"1.75rem",fontWeight:"400"}],"body-sm":["0.875rem",{lineHeight:"1.25rem",fontWeight:"400"}],display:["3.5rem",{lineHeight:"4rem",letterSpacing:"-0.03em",fontWeight:"800"}],"headline-lg":["2.25rem",{lineHeight:"2.75rem",letterSpacing:"-0.02em",fontWeight:"700"}],"body-md":["1rem",{lineHeight:"1.5rem",fontWeight:"400"}]}}}}</script></head><body class="bg-surface font-body-md text-body-md text-on-surface antialiased"><header class="fixed top-0 left-0 w-full z-50 bg-surface-container-lowest/95 backdrop-blur-md border-b border-outline-variant/30 shadow-[0_1px_8px_rgba(0,0,0,0.03)]"><div class="bg-surface-container-low/70 border-b border-outline-variant/20 px-4 py-1.5"><div class="max-w-7xl mx-auto flex items-center justify-between font-label-md text-label-md"><div class="flex items-center gap-2"><span class="flex h-2 w-2 rounded-full bg-tertiary-fixed-dim ring-4 ring-tertiary-fixed/30"></span><span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Community Live Network</span><span class="text-outline-variant">•</span><span class="text-on-surface-variant">98.4% verified match confidence rate across 42 active campuses</span></div><div class="hidden sm:flex items-center gap-4 text-on-surface-variant"><span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px] text-secondary">verified_user</span> Instant Owner Verification</span><a class="text-secondary hover:text-on-secondary-container transition-colors" data-path="search" href="#">View real-time feed →</a></div></div></div><div class="h-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4"><div class="flex items-center gap-8"><a class="flex items-center gap-3 shrink-0 group" data-path="home" href="#"><img alt="Lost Link Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/ALJJyrAWkuYliyQSJANRbojEO-eUUWgyAcLcHTK2--plMIchupuR3pZIDpC6_3MBxU-wFd3VQaPAH8C70WC5-9qiyDPdwjLym2mjQ6JuheG-qSpwg0S3Ww49hsjkYgniXstMt9UQklivfrH8eaprzVxd5Qd3uEg1O3rlV-HADiDWggYqmHh0HCQuYOwJKZqWjadissjaDuFU-k-tGYSVJwLF7rfkVkzMrwCRzW9uhR6PeoavQg"/><span class="font-headline-sm text-headline-sm text-primary tracking-tight">Lost<span class="text-secondary">Link</span></span></a><nav class="hidden lg:flex items-center gap-1" data-active-classes="bg-surface-container text-on-surface font-bold rounded-lg shadow-sm"><a aria-current="page" class="px-3 py-2 transition-all bg-surface-container text-on-surface font-bold rounded-lg shadow-sm" data-path="home" href="#">Home</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="search" href="#">Search Items</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="report-lost" href="#">Report Lost</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="report-found" href="#">Report Found</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="details" href="#">Item Details</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="dashboard" href="#">Dashboard</a></nav></div><div class="flex items-center gap-3"><a class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-on-primary font-label-lg text-label-lg rounded-xl hover:bg-primary-container hover:text-on-primary transition-all shadow-[0_2px_4px_rgba(0,0,0,0.1)] active:scale-95" data-path="report-lost" href="#"><span class="material-symbols-outlined text-[18px]">add_circle</span><span>Report Item</span></a><button aria-label="Notifications" class="relative p-2 rounded-xl text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[22px]">notifications</span><span class="absolute top-1.5 right-1.5 flex h-2 w-2 rounded-full bg-secondary ring-2 ring-surface-container-lowest"></span></button><div class="h-6 w-px bg-outline-variant/40 hidden sm:block"></div><div class="flex items-center gap-2 pl-1"><a class="flex items-center gap-2.5 p-1 rounded-full hover:ring-2 hover:ring-secondary/30 transition-all" data-path="dashboard" href="#"><img alt="Profile" class="w-8 h-8 rounded-full object-cover ring-1 ring-outline-variant/40" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDjMfrt-WEROSs2iJonvDsI4X3dqr0syl44qQp3LwwHfIlcSGQMOl4GS0KC7vT6SOnT8dhMVBJDJp8YmS-0NjjCTqyL_RU4ygw-wUK2I8Pm8eBwffKabEqxJZ0xBa1pbx3oDlwVeoD6BJ-YSsclUL0rvsDqO6E1oLG0pSZLxOGechPHnHrFTTRTI3q4ZE_yGdwq7naecv_TVwhMVzO7nPNA1BpB0KGUSWYGYq3he3LN"/><span class="material-symbols-outlined text-[16px] text-on-surface-variant hidden md:block">expand_more</span></a></div></div></div></header><main class="w-full pt-24 bg-surface min-h-screen"><div class="flex flex-col w-full">
<!-- Hero Section -->
<section class="relative w-full overflow-hidden bg-surface-container-lowest pb-16 pt-8 md:pb-24 md:pt-12">
<!-- Atmospheric Ambient Glows (Contained) -->
<div class="pointer-events-none absolute -left-40 -top-40 h-[480px] w-[480px] rounded-full bg-secondary-container/20 blur-3xl"></div>
<div class="pointer-events-none absolute -right-32 top-20 h-[420px] w-[420px] rounded-full bg-surface-variant/40 blur-3xl"></div>
<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<!-- Network Live Status Pill -->
<div class="flex items-center justify-center">
<div class="inline-flex items-center gap-2 rounded-full bg-surface-container-low px-4 py-1.5 shadow-sm">
<span class="flex h-2 w-2 rounded-full bg-tertiary-fixed-dim animate-pulse"></span>
<span class="font-label-caps text-label-caps tracking-wider text-secondary uppercase">
            ⚡ AI-Assisted Smart Matching Live across 140+ Campuses &amp; Hubs
          </span>
</div>
</div>
<!-- Main Typography Stack -->
<div class="mx-auto mt-6 max-w-4xl text-center">
<h1 class="font-display text-display text-on-surface tracking-tight">
          Lost Something? <br class="hidden sm:inline"/>
<span class="bg-gradient-to-r from-primary via-secondary to-secondary-container bg-clip-text text-transparent">
            Let's Find It Together.
          </span>
</h1>
<p class="mx-auto mt-5 max-w-2xl font-body-lg text-body-lg text-on-surface-variant">
          The intelligent community recovery network connecting students, commuters, and staff. Report lost belongings in 60 seconds or help return found valuables safely.
        </p>
<!-- Dual Primary Action CTAs -->
<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
<a class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 rounded-xl bg-primary px-8 py-3.5 font-label-lg text-label-lg text-on-primary shadow-lg shadow-primary/10 transition-all hover:bg-primary-container hover:shadow-xl active:scale-95" data-path="report-lost" href="#">
<span class="material-symbols-outlined text-[20px] text-tertiary-fixed-dim">search_insights</span>
<span>Report Lost Item</span>
</a>
<a class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 rounded-xl bg-secondary px-8 py-3.5 font-label-lg text-label-lg text-on-secondary shadow-lg shadow-secondary/20 transition-all hover:bg-on-secondary-container active:scale-95" data-path="report-found" href="#">
<span class="material-symbols-outlined text-[20px]">volunteer_activism</span>
<span>Report Found Item</span>
</a>
</div>
</div>
<!-- Omni-Search Bar Card -->
<div class="relative mx-auto mt-12 max-w-5xl rounded-2xl bg-surface p-3 shadow-xl md:p-4">
<form class="flex flex-col gap-3 lg:flex-row lg:items-center">
<!-- Text Input -->
<div class="relative flex-1">
<span class="material-symbols-outlined pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant">
              search
            </span>
<input class="h-12 w-full rounded-xl bg-surface-container-lowest pl-11 pr-14 font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:ring-2 focus:ring-secondary/40" placeholder="Search for keys, AirPods, backpacks, student IDs..." type="text"/>
<span class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 rounded bg-surface-container px-2 py-0.5 font-label-md text-label-md text-on-surface-variant">
              ⌘K
            </span>
</div>
<!-- Category Select -->
<div class="relative min-w-[190px]">
<span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">
              category
            </span>
<select aria-label="Item Category" class="h-12 w-full appearance-none rounded-xl bg-surface-container-lowest pl-10 pr-9 font-label-lg text-label-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary/40">
<option value="">All Categories</option>
<option value="electronics">Electronics</option>
<option value="wallets">Wallets &amp; Cards</option>
<option value="ids">Student IDs &amp; Badges</option>
<option value="keys">Keys &amp; FOBs</option>
<option value="bags">Bags &amp; Backpacks</option>
<option value="jewelry">Jewelry &amp; Watches</option>
</select>
<span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">
              expand_more
            </span>
</div>
<!-- Location Select -->
<div class="relative min-w-[210px]">
<span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">
              distance
            </span>
<select aria-label="Location Zone" class="h-12 w-full appearance-none rounded-xl bg-surface-container-lowest pl-10 pr-9 font-label-lg text-label-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary/40">
<option value="">All Locations</option>
<option value="north-lib">North Campus Library</option>
<option value="student-union">Student Union</option>
<option value="metro-line-4">Metro Line 4 Transit</option>
<option value="dining-hall">Central Dining Commons</option>
<option value="rec-center">Recreation Athletic Center</option>
<option value="stem-hall">Engineering &amp; Science Hall</option>
</select>
<span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">
              expand_more
            </span>
</div>
<!-- Submit Button -->
<button class="h-12 w-full lg:w-auto px-6 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg flex items-center justify-center gap-2 hover:bg-primary-container transition-all shadow-md active:scale-95 shrink-0" type="button">
<span class="material-symbols-outlined text-[18px]">travel_explore</span>
<span>Find Item</span>
</button>
</form>
</div>
<!-- Trust Metrics Strip -->
<div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3 sm:gap-6 max-w-4xl mx-auto">
<div class="flex items-center gap-4 rounded-xl bg-surface-container-low p-4 shadow-sm">
<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-surface-container-lowest text-secondary">
<span class="material-symbols-outlined text-[28px]">verified</span>
</div>
<div>
<p class="font-headline-sm text-headline-sm text-on-surface">94% Rate</p>
<p class="font-body-sm text-body-sm text-on-surface-variant">Recovery for registered items</p>
</div>
</div>
<div class="flex items-center gap-4 rounded-xl bg-surface-container-low p-4 shadow-sm">
<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-surface-container-lowest text-tertiary-fixed-dim">
<span class="material-symbols-outlined text-[28px]">handshake</span>
</div>
<div>
<p class="font-headline-sm text-headline-sm text-on-surface">12,480+</p>
<p class="font-body-sm text-body-sm text-on-surface-variant">Items successfully reunited</p>
</div>
</div>
<div class="flex items-center gap-4 rounded-xl bg-surface-container-low p-4 shadow-sm">
<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-surface-container-lowest text-secondary">
<span class="material-symbols-outlined text-[28px]">speed</span>
</div>
<div>
<p class="font-headline-sm text-headline-sm text-on-surface">&lt; 4 Hours</p>
<p class="font-body-sm text-body-sm text-on-surface-variant">Average AI match resolution</p>
</div>
</div>
</div>
</div>
</section>
<!-- How It Works Section -->
<section class="w-full bg-surface py-20">
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
<div>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary">Structured Recovery Protocol</span>
<h2 class="font-headline-lg text-headline-lg text-on-surface mt-2">How LostLink Resolves Matches in Minutes</h2>
</div>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md">
          Zero friction reporting backed by neural visual embedding matching and tamper-evident custody handoffs.
        </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
<!-- Step 1 -->
<div class="group relative rounded-2xl bg-surface-container-lowest p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
<div class="flex items-center justify-between mb-8">
<span class="flex h-12 w-12 items-center justify-center rounded-xl bg-surface-container text-primary font-headline-sm text-headline-sm">
              01
            </span>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-on-surface-variant bg-surface-container px-3 py-1 rounded-full">
              60s Intake
            </span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">Report with Details</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6">
            Upload clear photos, drop an exact geo-pin on campus maps, and let our computer vision automatically tag serial codes, case scratches, and distinct identifiers.
          </p>
<div class="flex items-center gap-2 font-label-md text-label-md text-secondary">
<span class="material-symbols-outlined text-[18px]">add_a_photo</span>
<span>Camera &amp; metadata auto-parsing</span>
</div>
</div>
<!-- Step 2 -->
<div class="group relative rounded-2xl bg-surface-container-lowest p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
<div class="flex items-center justify-between mb-8">
<span class="flex h-12 w-12 items-center justify-center rounded-xl bg-secondary-container/30 text-secondary font-headline-sm text-headline-sm">
              02
            </span>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary bg-surface-container px-3 py-1 rounded-full">
              Real-Time AI
            </span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">Instant Smart Match</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6">
            Our multi-modal algorithm cross-checks lost reports against active found submissions, transit custody logs, and local reception desks with 98% confidence scoring.
          </p>
<div class="flex items-center gap-2 font-label-md text-label-md text-secondary">
<span class="material-symbols-outlined text-[18px]">hub</span>
<span>Neural item correlation</span>
</div>
</div>
<!-- Step 3 -->
<div class="group relative rounded-2xl bg-surface-container-lowest p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
<div class="flex items-center justify-between mb-8">
<span class="flex h-12 w-12 items-center justify-center rounded-xl bg-tertiary-fixed/30 text-on-tertiary-fixed-variant font-headline-sm text-headline-sm">
              03
            </span>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-on-tertiary-fixed-variant bg-surface-container px-3 py-1 rounded-full">
              Zero-Dox Protocol
            </span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface mb-3">Safe Contact &amp; Secure Claim</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6">
            Validate ownership via blind question challenge or serial confirmation. Arrange seamless return via certified student union desks or transit lockboxes.
          </p>
<div class="flex items-center gap-2 font-label-md text-label-md text-secondary">
<span class="material-symbols-outlined text-[18px]">verified_user</span>
<span>Safe drop custody verification</span>
</div>
</div>
</div>
</div>
</section>
<!-- Recently Reported Items Section (Live Feed) -->
<section class="w-full bg-surface-container-low py-20">
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
<div>
<div class="flex items-center gap-2">
<span class="h-2 w-2 rounded-full bg-tertiary-fixed-dim"></span>
<span class="font-label-caps text-label-caps uppercase tracking-wider text-on-surface-variant">Live Campus Registry</span>
</div>
<h2 class="font-headline-lg text-headline-lg text-on-surface mt-2">Recently Reported Items</h2>
</div>
<!-- Filter Pill Tabs -->
<div class="flex flex-wrap items-center gap-1.5 rounded-xl bg-surface-container p-1 shadow-inner">
<button class="tab-pill rounded-lg bg-surface-container-lowest px-4 py-2 font-label-md text-label-md text-on-surface shadow-sm transition-all" data-filter="all" type="button">
            All Recent
          </button>
<button class="tab-pill rounded-lg px-4 py-2 font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all" data-filter="lost" type="button">
            Lost Items (Needs Help)
          </button>
<button class="tab-pill rounded-lg px-4 py-2 font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all" data-filter="found" type="button">
            Found (Awaiting Owners)
          </button>
<button class="tab-pill rounded-lg px-4 py-2 font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all" data-filter="reunited" type="button">
            Recently Reunited 🎉
          </button>
</div>
</div>
<!-- Item Grid (6 Realistic Cards) -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="items-grid">
<!-- Card 1 -->
<div class="item-card group flex flex-col rounded-2xl bg-surface-container-lowest overflow-hidden shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl" data-status="lost">
<div class="relative h-52 w-full overflow-hidden bg-surface-container">
