<!-- Option A: Campus Security / Info Desk -->
<label class="relative flex items-start gap-4 p-4 rounded-xl cursor-pointer bg-surface-container-high transition-all">
<input checked="" class="mt-1 accent-primary w-4 h-4 text-primary" name="custody_mode" onchange="updateCustodyView('desk')" type="radio" value="desk"/>
<div class="flex-1">
<div class="flex items-center gap-2">
<span class="font-headline-sm text-headline-sm text-on-surface">Handed over to Campus Lost &amp; Found / Security Desk</span>
<span class="px-2 py-0.5 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-caps text-label-caps uppercase">Recommended</span>
</div>
