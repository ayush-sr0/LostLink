"space-lg":"1.5rem","space-xs":"0.25rem","space-xl":"2.5rem","gutter-mobile":"1rem"},fontFamily:{"headline-lg-mobile":["Plus Jakarta Sans"],"headline-sm":["Plus Jakarta Sans"],"label-lg":["Inter"],"label-caps":["Inter"],"headline-md":["Plus Jakarta Sans"],"label-md":["Inter"],"body-lg":["Inter"],"body-sm":["Inter"],display:["Plus Jakarta Sans"],"headline-lg":["Plus Jakarta Sans"],"body-md":["Inter"]},fontSize:{"headline-lg-mobile":["1.75rem",{lineHeight:"2.25rem",letterSpacing:"-0.02em",fontWeight:"700"}],"headline-sm":["1.25rem",{lineHeight:"1.75rem",letterSpacing:"-0.01em",fontWeight:"600"}],"label-lg":["0.875rem",{lineHeight:"1.25rem",letterSpacing:"0.01em",fontWeight:"600"}],"label-caps":["0.6875rem",{lineHeight:"0.875rem",letterSpacing:"0.06em",fontWeight:"700"}],"headline-md":["1.5rem",{lineHeight:"2rem",letterSpacing:"-0.015em",fontWeight:"600"}],"label-md":["0.75rem",{lineHeight:"1rem",letterSpacing:"0.02em",fontWeight:"600"}],"body-lg":["1.125rem",{lineHeight:"1.75rem",fontWeight:"400"}],"body-sm":["0.875rem",{lineHeight:"1.25rem",fontWeight:"400"}],display:["3.5rem",{lineHeight:"4rem",letterSpacing:"-0.03em",fontWeight:"800"}],"headline-lg":["2.25rem",{lineHeight:"2.75rem",letterSpacing:"-0.02em",fontWeight:"700"}],"body-md":["1rem",{lineHeight:"1.5rem",fontWeight:"400"}]}}}}</script></head><body class="bg-surface font-body-md text-body-md text-on-surface antialiased"><header class="fixed top-0 left-0 w-full z-50 bg-surface-container-lowest/95 backdrop-blur-md border-b border-outline-variant/30 shadow-[0_1px_8px_rgba(0,0,0,0.03)]"><div class="bg-surface-container-low/70 border-b border-outline-variant/20 px-4 py-1.5"><div class="max-w-7xl mx-auto flex items-center justify-between font-label-md text-label-md"><div class="flex items-center gap-2"><span class="flex h-2 w-2 rounded-full bg-tertiary-fixed-dim ring-4 ring-tertiary-fixed/30"></span><span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Community Live Network</span><span class="text-outline-variant">•</span><span class="text-on-surface-variant">98.4% verified match confidence rate across 42 active campuses</span></div><div class="hidden sm:flex items-center gap-4 text-on-surface-variant"><span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px] text-secondary">verified_user</span> Instant Owner Verification</span><a class="text-secondary hover:text-on-secondary-container transition-colors" data-path="search" href="#">View real-time feed →</a></div></div></div><div class="h-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4"><div class="flex items-center gap-8"><a class="flex items-center gap-3 shrink-0 group" data-path="home" href="#"><img alt="Lost Link Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/ALJJyrAWkuYliyQSJANRbojEO-eUUWgyAcLcHTK2--plMIchupuR3pZIDpC6_3MBxU-wFd3VQaPAH8C70WC5-9qiyDPdwjLym2mjQ6JuheG-qSpwg0S3Ww49hsjkYgniXstMt9UQklivfrH8eaprzVxd5Qd3uEg1O3rlV-HADiDWggYqmHh0HCQuYOwJKZqWjadissjaDuFU-k-tGYSVJwLF7rfkVkzMrwCRzW9uhR6PeoavQg"/><span class="font-headline-sm text-headline-sm text-primary tracking-tight">Lost<span class="text-secondary">Link</span></span></a><nav class="hidden lg:flex items-center gap-1" data-active-classes="bg-surface-container text-on-surface font-bold rounded-lg shadow-sm"><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="home" href="#">Home</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="search" href="#">Search Items</a><a aria-current="page" class="px-3 py-2 transition-all bg-surface-container text-on-surface font-bold rounded-lg shadow-sm" data-path="report-lost" href="#">Report Lost</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="report-found" href="#">Report Found</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="details" href="#">Item Details</a><a class="px-3 py-2 rounded-lg font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all" data-path="dashboard" href="#">Dashboard</a></nav></div><div class="flex items-center gap-3"><a class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-on-primary font-label-lg text-label-lg rounded-xl hover:bg-primary-container hover:text-on-primary transition-all shadow-[0_2px_4px_rgba(0,0,0,0.1)] active:scale-95" data-path="report-lost" href="#"><span class="material-symbols-outlined text-[18px]">add_circle</span><span>Report Item</span></a><button aria-label="Notifications" class="relative p-2 rounded-xl text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors"><span class="material-symbols-outlined text-[22px]">notifications</span><span class="absolute top-1.5 right-1.5 flex h-2 w-2 rounded-full bg-secondary ring-2 ring-surface-container-lowest"></span></button><div class="h-6 w-px bg-outline-variant/40 hidden sm:block"></div><div class="flex items-center gap-2 pl-1"><a class="flex items-center gap-2.5 p-1 rounded-full hover:ring-2 hover:ring-secondary/30 transition-all" data-path="dashboard" href="#"><img alt="Profile" class="w-8 h-8 rounded-full object-cover ring-1 ring-outline-variant/40" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDjMfrt-WEROSs2iJonvDsI4X3dqr0syl44qQp3LwwHfIlcSGQMOl4GS0KC7vT6SOnT8dhMVBJDJp8YmS-0NjjCTqyL_RU4ygw-wUK2I8Pm8eBwffKabEqxJZ0xBa1pbx3oDlwVeoD6BJ-YSsclUL0rvsDqO6E1oLG0pSZLxOGechPHnHrFTTRTI3q4ZE_yGdwq7naecv_TVwhMVzO7nPNA1BpB0KGUSWYGYq3he3LN"/><span class="material-symbols-outlined text-[16px] text-on-surface-variant hidden md:block">expand_more</span></a></div></div></div></header><main class="w-full pt-24 bg-surface min-h-screen"><div class="flex flex-col w-full">
<div class="relative w-full overflow-hidden bg-surface pb-16">
<div class="absolute -top-32 right-1/4 w-96 h-96 bg-secondary-fixed/30 rounded-full blur-3xl pointer-events-none"></div>
<div class="absolute top-64 -left-20 w-80 h-80 bg-surface-container-high/40 rounded-full blur-2xl pointer-events-none"></div>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
<!-- Editorial Header & Reassurance -->
<div class="mb-10 max-w-3xl">
<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-low text-secondary font-label-md text-label-md mb-3 shadow-sm">
<span class="material-symbols-outlined text-[16px] text-tertiary-fixed-dim" style="font-variation-settings: 'FILL' 1;">bolt</span>
<span>Instant Dual-Phase Neural Matcher Active</span>
</div>
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight mb-2">Report a Lost Item</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant">
          Fill in the details below. Our automated matching algorithm scans all newly logged custody reports across 42 partner hubs instantly.
        </p>
</div>
<!-- Step Progress Bar -->
<div class="mb-12 bg-surface-container-lowest p-4 sm:p-6 rounded-xl shadow-sm">
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 relative">
<div class="flex items-center gap-3">
<div class="w-9 h-9 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-lg text-label-lg font-bold shadow-md shrink-0">
              1
            </div>
<div class="min-w-0">
<span class="block font-label-caps text-label-caps text-secondary uppercase tracking-wider">Step 01</span>
<p class="font-label-lg text-label-lg text-on-surface font-bold truncate">Item Details</p>
</div>
</div>
<div class="flex items-center gap-3 opacity-80">
<div class="w-9 h-9 rounded-full bg-surface-container text-on-surface-variant flex items-center justify-center font-label-lg text-label-lg font-bold shrink-0">
              2
            </div>
<div class="min-w-0">
<span class="block font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Step 02</span>
<p class="font-label-lg text-label-lg text-on-surface truncate">Location &amp; Date</p>
</div>
</div>
<div class="flex items-center gap-3 opacity-80">
<div class="w-9 h-9 rounded-full bg-surface-container text-on-surface-variant flex items-center justify-center font-label-lg text-label-lg font-bold shrink-0">
              3
            </div>
<div class="min-w-0">
<span class="block font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Step 03</span>
<p class="font-label-lg text-label-lg text-on-surface truncate">Visuals &amp; Secrets</p>
</div>
</div>
<div class="flex items-center gap-3 opacity-80">
<div class="w-9 h-9 rounded-full bg-surface-container text-on-surface-variant flex items-center justify-center font-label-lg text-label-lg font-bold shrink-0">
              4
            </div>
<div class="min-w-0">
<span class="block font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Step 04</span>
<p class="font-label-lg text-label-lg text-on-surface truncate">Verification</p>
</div>
</div>
</div>
<div class="w-full bg-surface-container h-1.5 rounded-full mt-4 overflow-hidden">
<div class="bg-secondary h-full rounded-full transition-all duration-500 w-1/4"></div>
</div>
</div>
<!-- Main Layout Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<!-- Form Container Column (8 cols) -->
<div class="lg:col-span-8 space-y-8">
<form class="space-y-8" id="lost-report-form" onsubmit="event.preventDefault();">
<!-- SECTION 1: Item Basic Information -->
<div class="bg-surface-container-lowest p-6 sm:p-8 rounded-xl shadow-sm">
<div class="flex items-center gap-3 mb-6">
<span class="flex items-center justify-center w-8 h-8 rounded-lg bg-surface-container text-secondary font-headline-sm">
<span class="material-symbols-outlined text-[20px]">category</span>
</span>
<div>
<h2 class="font-headline-sm text-headline-sm text-on-surface">1. Item Basic Information</h2>
<p class="font-body-sm text-body-sm text-on-surface-variant">Core descriptors for immediate semantic search grouping</p>
</div>
</div>
<div class="space-y-5">
<div>
<label class="block font-label-lg text-label-lg text-on-surface mb-1.5" for="item-title">
                    Item Name / Title <span class="text-error">*</span>
</label>
<input class="w-full px-4 py-3 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-secondary placeholder:text-on-surface-variant/50" id="item-title" name="title" placeholder="e.g. Apple iPhone 15 Pro in Forest Green Silicone Case" required="" type="text"/>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<div>
<label class="block font-label-lg text-label-lg text-on-surface mb-1.5" for="category-select">
                      Category <span class="text-error">*</span>
</label>
<div class="relative">
<select class="w-full px-4 py-3 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm appearance-none focus:outline-none focus:ring-2 focus:ring-secondary cursor-pointer" id="category-select">
<option selected="" value="electronics">Electronics (Phones, Laptops, Audio)</option>
<option value="wallet">Wallet / Purse / Cards</option>
<option value="id">ID / Passport / Official Docs</option>
<option value="keys">Keys &amp; Fobs</option>
<option value="bag">Bag / Backpack / Luggage</option>
<option value="jewelry">Jewelry / Watch</option>
<option value="pets">Pets &amp; Collars</option>
<option value="other">Other Personal Effects</option>
</select>
<span class="material-symbols-outlined absolute right-3 top-3.5 pointer-events-none text-on-surface-variant text-[20px]">expand_more</span>
</div>
</div>
<div>
<label class="block font-label-lg text-label-lg text-on-surface mb-1.5" for="item-brand">
                      Brand / Manufacturer
                    </label>
<input class="w-full px-4 py-3 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-secondary placeholder:text-on-surface-variant/50" id="item-brand" placeholder="e.g. Apple, Sony, Herschel" type="text"/>
</div>
</div>
<div>
<label class="block font-label-lg text-label-lg text-on-surface mb-1.5" for="item-model">
                    Model Number or Edition
                  </label>
<input class="w-full px-4 py-3 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-secondary placeholder:text-on-surface-variant/50" id="item-model" placeholder="e.g. iPhone 15 Pro 256GB (Natural Titanium body)" type="text"/>
</div>
<!-- Color selector pills -->
<div>
<label class="block font-label-lg text-label-lg text-on-surface mb-2">
                    Primary &amp; Accent Colors
                  </label>
<div class="flex flex-wrap gap-2" id="color-pill-container">
<button class="color-pill active px-3.5 py-1.5 rounded-full font-label-md text-label-md flex items-center gap-1.5 bg-primary text-on-primary shadow-sm" data-color="Black" type="button">
<span class="w-3 h-3 rounded-full bg-black shadow-inner"></span> Black
                    </button>
<button class="color-pill px-3.5 py-1.5 rounded-full font-label-md text-label-md flex items-center gap-1.5 bg-surface-container-low text-on-surface hover:bg-surface-container transition-all" data-color="Midnight Blue" type="button">
<span class="w-3 h-3 rounded-full bg-secondary shadow-inner"></span> Navy / Blue
                    </button>
<button class="color-pill px-3.5 py-1.5 rounded-full font-label-md text-label-md flex items-center gap-1.5 bg-surface-container-low text-on-surface hover:bg-surface-container transition-all" data-color="Forest Green" type="button">
<span class="w-3 h-3 rounded-full bg-tertiary-container shadow-inner"></span> Forest Green
                    </button>
<button class="color-pill px-3.5 py-1.5 rounded-full font-label-md text-label-md flex items-center gap-1.5 bg-surface-container-low text-on-surface hover:bg-surface-container transition-all" data-color="Silver" type="button">
<span class="w-3 h-3 rounded-full bg-surface-dim shadow-inner"></span> Silver / Grey
                    </button>
<button class="color-pill px-3.5 py-1.5 rounded-full font-label-md text-label-md flex items-center gap-1.5 bg-surface-container-low text-on-surface hover:bg-surface-container transition-all" data-color="Gold" type="button">
<span class="w-3 h-3 rounded-full bg-yellow-400 shadow-inner"></span> Gold / Tan
                    </button>
<button class="color-pill px-3.5 py-1.5 rounded-full font-label-md text-label-md flex items-center gap-1.5 bg-surface-container-low text-on-surface hover:bg-surface-container transition-all" data-color="Red" type="button">
<span class="w-3 h-3 rounded-full bg-error shadow-inner"></span> Red / Burgundy
                    </button>
</div>
</div>
</div>
</div>
<!-- SECTION 2: Detailed Description & Confidential Proof -->
<div class="bg-surface-container-lowest p-6 sm:p-8 rounded-xl shadow-sm">
<div class="flex items-center gap-3 mb-6">
<span class="flex items-center justify-center w-8 h-8 rounded-lg bg-surface-container text-secondary font-headline-sm">
<span class="material-symbols-outlined text-[20px]">fingerprint</span>
</span>
<div>
<h2 class="font-headline-sm text-headline-sm text-on-surface">2. Detailed Description &amp; Unique Identifiers</h2>
<p class="font-body-sm text-body-sm text-on-surface-variant">Visible attributes that distinguish this exact object</p>
</div>
</div>
<div class="space-y-6">
<div>
<label class="block font-label-lg text-label-lg text-on-surface mb-1.5" for="public-description">
                    Physical Characteristics &amp; Wear
                  </label>
<textarea class="w-full px-4 py-3 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-secondary placeholder:text-on-surface-variant/50 resize-y" id="public-description" placeholder="Describe scratches, surface wear, stickers, screen lock wallpaper, serial number or engraved initials on the back..." rows="3"></textarea>
</div>
<!-- Confidential Proof of Ownership Card -->
<div class="p-5 rounded-xl bg-surface-container-low">
<div class="flex items-start gap-3">
<span class="material-symbols-outlined text-secondary text-[24px] shrink-0 mt-0.5" style="font-variation-settings: 'FILL' 1;">encrypted</span>
<div class="flex-1">
<div class="flex items-center justify-between">
<label class="font-label-lg text-label-lg text-on-surface font-bold block" for="secret-verifier">
                          Confidential Proof of Ownership
                        </label>
<span class="font-label-caps text-label-caps text-secondary uppercase bg-secondary-fixed/50 px-2 py-0.5 rounded">Encrypted Zero-Knowledge</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1 mb-3">
                        Provide a secret detail only you know (e.g. precise lockscreen wallpaper photo, hidden card in phone slot, IMEI end-digits, inside engraving). This is completely hidden from public listings and only verified during claim handoff.
                      </p>
<input class="w-full px-4 py-2.5 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-secondary placeholder:text-on-surface-variant/50" id="secret-verifier" placeholder="e.g. Wallpaper is an orange tabby cat; inner card sleeve contains a blue transit pass" type="text"/>
</div>
</div>
</div>
</div>
</div>
<!-- SECTION 3: When and Where was it Lost? -->
<div class="bg-surface-container-lowest p-6 sm:p-8 rounded-xl shadow-sm">
<div class="flex items-center gap-3 mb-6">
<span class="flex items-center justify-center w-8 h-8 rounded-lg bg-surface-container text-secondary font-headline-sm">
<span class="material-symbols-outlined text-[20px]">pin_drop</span>
</span>
<div>
<h2 class="font-headline-sm text-headline-sm text-on-surface">3. Location &amp; Timeline</h2>
<p class="font-body-sm text-body-sm text-on-surface-variant">Calibrate spatial proximity against found property submissions</p>
</div>
</div>
<div class="space-y-5">
<div>
<label class="block font-label-lg text-label-lg text-on-surface mb-1.5" for="location-input">
                    Last Seen Location <span class="text-error">*</span>
</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3.5 top-3 text-secondary text-[20px]">search</span>
<input class="w-full pl-11 pr-4 py-3 rounded-lg bg-surface-container-lowest text-on-surface font-body-md shadow-sm focus:outline-none focus:ring-2 focus:ring-secondary placeholder:text-on-surface-variant/50" id="location-input" placeholder="e.g. Main Campus Library, 4th Floor Study Room 402 or Blue Shuttle Stop" required="" type="text"/>
</div>
</div>
<!-- Interactive Mini-Map Pin Selector -->
<div class="rounded-xl overflow-hidden shadow-sm relative group">
<div class="w-full h-56 bg-cover bg-center transition-all duration-300 group-hover:scale-[1.01]" data-location="Main Library, Stanford University, Stanford, CA" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBkeq0gIT3oGI2-zuqc0sWnhv7UTEoe1wHOtWgHsvSTxQ9SMbEb7_BIbxDg3VpnwfFC5UXXLFP9xnu1aXWVfHChlyfxiwJjGQ01K71vp3XUGyD2YvF6WAGcMa50d7pcEbFdzqA_-wYzVxFuLsyL_HWK0t5Bb4UXhxB9CObYTjb8NCP-o_mWIMJjfVy5v2jjAPsfzU-a9LE1_DufO2Yy0Z-i6_IIpJoNEmEv3Q6N9eq9')"></div>
<div class="absolute inset-0 bg-primary/20 pointer-events-none flex items-center justify-center">
<div class="flex flex-col items-center">
<div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-xl animate-bounce">
<span class="material-symbols-outlined text-[24px]">location_on</span>
</div>
<span class="bg-surface-container-lowest/90 backdrop-blur-md px-3 py-1 rounded-full text-on-surface font-label-md text-label-md font-bold shadow-md mt-1">
                        Selected: North Quad Annex
                      </span>
</div>
</div>
<div class="absolute bottom-3 right-3 flex gap-2">
<button class="px-3 py-1.5 rounded-lg bg-surface-container-lowest/95 backdrop-blur-md text-on-surface font-label-md text-label-md shadow-md flex items-center gap-1.5 hover:bg-surface-container-high transition-colors" type="button">
<span class="material-symbols-outlined text-[16px] text-secondary">my_location</span>
