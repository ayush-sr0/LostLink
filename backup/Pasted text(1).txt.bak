<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-error">flag</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface">Report Discrepancy</h3>
</div>
<button aria-label="Close dialog" class="p-1 rounded-lg text-outline hover:text-on-surface transition-colors" onclick="toggleModal('dispute-modal')">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
        Flag this record if the location, description, or custody status contains errors or fraudulent claims.
      </p>
<div class="space-y-2">
<label class="flex items-center gap-2.5 p-2.5 rounded-lg bg-surface-container-low cursor-pointer">
<input checked="" class="accent-secondary" name="dispute-reason" type="radio"/>
<span class="font-body-sm text-body-sm text-on-surface">Incorrect location or timestamp info</span>
</label>
<label class="flex items-center gap-2.5 p-2.5 rounded-lg bg-surface-container-low cursor-pointer">
<input class="accent-secondary" name="dispute-reason" type="radio"/>
<span class="font-body-sm text-body-sm text-on-surface">Item was already retrieved / redundant listing</span>
</label>
<label class="flex items-center gap-2.5 p-2.5 rounded-lg bg-surface-container-low cursor-pointer">
<input class="accent-secondary" name="dispute-reason" type="radio"/>
<span class="font-body-sm text-body-sm text-on-surface">Suspected fraudulent or privacy violation</span>
</label>
</div>
<div class="flex justify-end gap-2 pt-2">
<button class="px-4 py-2 rounded-lg font-label-md text-label-md text-on-surface-variant" onclick="toggleModal('dispute-modal')">Dismiss</button>
<button class="px-4 py-2 rounded-lg bg-error text-on-error font-label-md text-label-md" onclick="alert('Thank you. A security administrator will review listing LL-89421.'); toggleModal('dispute-modal')">Submit Report</button>
</div>
</div>
</div>
<!-- Micro-interactions and Modal Control Script -->
<script>
    function toggleModal(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      if (modal.classList.contains('hidden')) {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    function swapImage(thumbBtn, index) {
      const mainImg = document.getElementById('main-item-view');
      const thumbImg = thumbBtn.querySelector('img');
      if (mainImg && thumbImg) {
        mainImg.src = thumbImg.src;
      }
      
      const parent = thumbBtn.parentElement;
      if (parent) {
        Array.from(parent.children).forEach(btn => {
          btn.classList.add('opacity-70');
        });
        thumbBtn.classList.remove('opacity-70');
      }
    }

    function copyShareLink() {
      const label = document.getElementById('share-label');
      navigator.clipboard?.writeText(window.location.href);
      if (label) {
        const originalText = label.innerText;
        label.innerText = 'Link Copied!';
        setTimeout(() => {
          label.innerText = originalText;
        }, 2000);
      }
    }

    function handleClaimSubmit(event) {
      event.preventDefault();
      toggleModal('claim-challenge-modal');
      alert('Verification initiated. Your claim data has been sent to Officer Henderson at Desk 14. You will receive an SMS and dashboard notification once verified.');
    }

    function handleSendChat(event) {
      event.preventDefault();
      const input = event.target.querySelector('input');
      if (!input || !input.value.trim()) return;
      
      const messageContainer = event.target.previousElementSibling;
      const newBubble = document.createElement('div');
      newBubble.className = "flex flex-col max-w-[80%] ml-auto bg-primary text-on-primary p-3 rounded-2xl rounded-tr-sm shadow-sm";
      newBubble.innerHTML = `<span class="font-label-caps text-label-caps text-on-primary-container">You • Just now</span><p class="font-body-sm text-body-sm mt-1">${input.value}</p>`;
      messageContainer.appendChild(newBubble);
      input.value = '';
      messageContainer.scrollTop = messageContainer.scrollHeight;
    }
  </script>
</div></main><footer class="w-full bg-surface-container-lowest border-t border-outline-variant/30"><div class="bg-surface-container-low/60 border-b border-outline-variant/20 py-3 px-4 sm:px-6 lg:px-8"><div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4 font-label-md text-label-md"><div class="flex items-center gap-2.5"><span class="flex h-2.5 w-2.5 rounded-full bg-tertiary-fixed-dim animate-pulse"></span><span class="font-label-lg text-label-lg text-on-surface">System Operational:</span><span class="text-on-surface-variant">All campus &amp; community recovery feeds active</span></div><div class="flex items-center gap-6 text-on-surface-variant"><span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[16px] text-secondary">lock</span> 256-bit Encrypted Claim Registry</span><span class="hidden md:flex items-center gap-1.5"><span class="material-symbols-outlined text-[16px] text-secondary">shield</span> FERPA &amp; Campus Privacy Compliant</span></div></div></div><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16"><div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8 lg:gap-12"><div class="col-span-2"><a class="flex items-center gap-2.5 mb-4" data-path="home" href="#"><img alt="Lost Link Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/ALJJyrAWkuYliyQSJANRbojEO-eUUWgyAcLcHTK2--plMIchupuR3pZIDpC6_3MBxU-wFd3VQaPAH8C70WC5-9qiyDPdwjLym2mjQ6JuheG-qSpwg0S3Ww49hsjkYgniXstMt9UQklivfrH8eaprzVxd5Qd3uEg1O3rlV-HADiDWggYqmHh0HCQuYOwJKZqWjadissjaDuFU-k-tGYSVJwLF7rfkVkzMrwCRzW9uhR6PeoavQg"/><span class="font-headline-sm text-headline-sm text-primary tracking-tight">Lost<span class="text-secondary">Link</span></span></a><p class="font-body-sm text-body-sm text-on-surface-variant max-w-sm mb-6">The trusted community-powered network engineered to resolve the stress of lost property. Connecting finders, owners, and security operations with verifiable high-integrity claims.<